{
  "date": "2026-11-06",
  "scope": "Read-only physical placement constraints for r6 electrical design; no official project changed. Relative cardinal directions assume footprint rotation=0 on F.Cu. Suggested distances are engineering placement targets, not datasheet guarantees.",
  "sources": {
    "BQ24074": {
      "file": "hardware/reference/charge-r5/bq24074.pdf",
      "url": "https://www.ti.com/lit/ds/symlink/bq24074.pdf",
      "section": "12.1, PDF p40; pin descriptions p7-9",
      "requirements": [
        "Input and output decoupling close to IC, short runs to power pins and GND.",
        "Small-signal ground paths kept clear of high-current charging/discharging return paths.",
        "Connect exposed pad to GND and provide heat spreading; VSS pin8 must also have its own ground connection."
      ]
    },
    "TPS63802": {
      "file": "hardware/reference/power/tps63802.pdf",
      "url": "https://www.ti.com/lit/ds/symlink/tps63802.pdf",
      "section": "12.1, PDF p28",
      "requirements": [
        "Input/output caps close, short/wide power traces.",
        "Keep FB sense away from L1/L2 switch nodes.",
        "Power and control ground return topology joins close to IC; preserve continuous system GND reference rather than cutting the plane."
      ]
    },
    "TPS22918": {
      "file": "hardware/reference/power/tps22918.pdf",
      "url": "https://www.ti.com/lit/ds/symlink/tps22918.pdf",
      "section": "11.1, PDF p20",
      "requirements": [
        "Short wide VIN/VOUT paths.",
        "Input ceramic bypass closest to VIN/GND pins."
      ]
    },
    "MAX17048": {
      "file": "hardware/reference/power/max17048.pdf",
      "url": "https://www.analog.com/media/en/technical-documentation/data-sheets/MAX17048-MAX17049.pdf",
      "section": "Pin descriptions, PDF p8",
      "requirements": [
        "VDD pin3 is measured voltage input on MAX17048: connect positive protected battery terminal, bypass0.1uF.",
        "GND pin4 connects negative battery terminal; CELL2 also connects pack positive according to project schematic."
      ]
    },
    "TCA9539": {
      "file": "hardware/reference/power/tca9539.pdf",
      "url": "https://www.ti.com/lit/ds/symlink/tca9539.pdf",
      "section": "11.1, PDF p31",
      "requirements": [
        "Decoupling close to VCC.",
        "Four-layer board and dedicated ground plane appropriate for dense routing."
      ]
    },
    "TLV1822": {
      "file": "hardware/reference/charge-r5/tlv1822.pdf",
      "url": "https://www.ti.com/lit/ds/symlink/tlv1822.pdf",
      "section": "8.4.1, PDF p27",
      "requirements": [
        "Supply bypass closest possible, to solid ground.",
        "Minimize unintended input-output coupling; do not run them parallel without grounded separation.",
        "Treat output edges as fast logic even though measured temperature is slow."
      ]
    }
  },
